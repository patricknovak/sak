// The Super Pools app on Cloudflare (docs/EXPANSION.md B5, hosting). A Worker that serves the built site (dist/) as
// static assets, Cloudflare's successor to Pages: unlike Pages it takes a wildcard route, which is what league by host
// needs (every <web name>.superpoolsai.com is the same app; the app reads the host). Deployed by
// .github/workflows/cloudflare.yml once the CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID secrets exist.
{
  "name": "superpools-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // the app routes in the hash (#/team), so every path is the one page
    "not_found_handling": "single-page-application"
  },
  // steps 1 and 2 of the move in one: SaK at sak.superpoolsai.com beside GitHub Pages. A custom domain, so the deploy
  // makes the DNS record and the certificate itself; the new address is the preview, so no workers.dev one.
  "workers_dev": false,
  "routes": [{ "pattern": "sak.superpoolsai.com", "custom_domain": true }]
  // every other league's address comes next, with a proxied wildcard DNS record (AAAA * 100::) on superpoolsai.com:
  // { "pattern": "*.superpoolsai.com/*", "zone_name": "superpoolsai.com" }
}
